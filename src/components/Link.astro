---
const {class: className} = Astro.props || { class: "" };
const links = [
  {
    href: "https://www.youtube.com/@rdlfkz",
    label: "YouTube",
    class: "fa-brands fa-youtube"
  },
  {
    href: "https://www.nicovideo.jp/series/578048?ref=garage_share_other",
    label: "niconico",
    class: "/images/niconico_logo_icon_248372.svg"
  },
  {
    href: "https://music.apple.com/jp/artist/rudolf/1530486958",
    label: "Apple Music",
    class: "fa-brands fa-apple"
  },
  {
    href: "https://open.spotify.com/intl-ja/artist/0ZEutI3j4pqzwmUxE926Nl?si=SIWEwW_LQ3OH3iQ6hByR6g",
    label: "Spotify",
    class: "fa-brands fa-spotify"
  },
  {
    href: "https://www.tunecore.co.jp/artists/rdlfkz",
    label: "TuneCore",
    class: "fa-solid fa-music"
  },
  {
    href: "",
    label: "br",
    class: "br"
  },
  {
    href: "https://soundcloud.com/rdlfkz",
    label: "SoundCloud",
    class: "fa-brands fa-soundcloud"
  },
  {
    href: "https://rdlfkz.bandcamp.com/",
    label: "bandcamp",
    class: "fa-brands fa-bandcamp"
  },
  {
    href: "https://www.instagram.com/rdlfkz",
    label: "Instagram",
    class: "fa-brands fa-instagram"
  },
  {
    href: "https://x.com/rdlfkz",
    label: "X",
    class: "fa-brands fa-x-twitter"
  },
];
---
<div class={className}>
  {links.map(item => (
    item.class === "br" ? (
      <br class="mobile-break" />
    ) : (
      <a href={item.href} aria-label={item.label}>
        {item.class.startsWith("fa") ? (
          <i class={item.class}></i>
          ) : (
            <span
              class="icon"
              style={`--icon: url('${item.class}')`}
            ></span>
          )}
      </a>
    )
  ))}
</div>
<div class="dthm">
  <a class="dthm_link" href="https://detohma.com/">
    My band, 
    <img class="dthm_logo" src="/images/dthm_minimum.svg" alt="detohma logo" />
  </a>
</div>

<style>
  a {
    color: inherit;
    text-decoration: none;
    margin: 0 6px;
    font-size: 1.5rem;
  }

  a:hover {
    color: var(--muted);
    text-decoration: none;
  }

  .mobile-break {
    display: none;
  }

  @media (max-width: 420px) {
    .mobile-break {
      display: block;
      flex-basis: 100%;
    }
  }

  .icon {
    display: inline-block;
    width: 1em;
    height: 1em;
    vertical-align: -0.1em;

    background-color: currentColor;
    mask: var(--icon) center / contain no-repeat;
    -webkit-mask: var(--icon) center / contain no-repeat;
  }

  .dthm {
    text-align: center;
  }

  .dthm_link {
    font-size: 0.9rem;
    line-height: 3rem;
    color: var(--text)
    display: flex;
    align-items: flex-start;
  }

  .dthm_logo {
    height: 1.3rem;
    vertical-align: middle;
    vertical-align: -5px;
    border: none;
    display: inline-block;
  }
</style>